# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# gradle output of local expo modules (their sources are committed)
/modules/*/android/build/
/modules/*/android/.gradle/

# agent local state
.claude/settings.local.json

.env
.env.eas-simulator

# disposable eas simulator evidence
.artifacts/eas-simulator/

# local native module build outputs
modules/*/android/build/
modules/*/android/.cxx/
