    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:prod": "EXPO_PUBLIC_DEMO_MODE=0 expo start",
    "start:demo": "EXPO_PUBLIC_DEMO_MODE=1 expo start",
    "android": "expo run:android",
    "android:prod": "EXPO_PUBLIC_DEMO_MODE=0 expo run:android",
    "android:demo": "EXPO_PUBLIC_DEMO_MODE=1 expo run:android",
    "ios": "expo run:ios",
    "ios:prod": "EXPO_PUBLIC_DEMO_MODE=0 expo run:ios",
    "ios:demo": "EXPO_PUBLIC_DEMO_MODE=1 expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver.js",
    "setupFiles": [
      "./tests/jest-setup.ts",
      "react-native-gesture-handler/jestSetup.js",
      "@shopify/react-native-skia/jestSetup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(.bun|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@shopify/react-native-skia|standard-navigation))"
    ]
  },
  "private": true,
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ],
  "patchedDependencies": {
    "expo-symbols@58.0.4": "patches/expo-symbols@58.0.4.patch"
